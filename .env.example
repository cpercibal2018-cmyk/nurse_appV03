# AIGH Nursing Workforce Management System — Environment Variables
# Copy to .env and fill all values before running docker-compose up
# NEVER commit .env to git

# ── Application ───────────────────────────────────────────────────────────────
APP_ORIGIN=https://nursing.aigh.sa          # Used for CORS + CSRF Origin check
NODE_ENV=production

# ── Database ──────────────────────────────────────────────────────────────────
# Four DB roles (§10.7 privilege separation):
#   nurseapp_owner      — provisioning only, never used at runtime
#   nurseapp_migration  — CREATE/ALTER/DROP, CI/CD only (use MIGRATION_DATABASE_URL)
#   nurseapp_runtime    — SELECT/INSERT/UPDATE/DELETE business tables (API + worker)
#   nurseapp_backup     — pg_read_all_data + REPLICATION (backup agent)
#   nurseapp_audit_reader — SELECT audit/log tables only

POSTGRES_DB=nurseapp
POSTGRES_OWNER_USER=nurseapp_owner
POSTGRES_OWNER_PASSWORD=CHANGE_ME_owner_password

# Runtime connection (used by API + worker at runtime)
DATABASE_URL=postgresql://nurseapp_runtime:CHANGE_ME_runtime_password@db:5432/nurseapp

# Migration connection (CI/CD only — never in production containers)
MIGRATION_DATABASE_URL=postgresql://nurseapp_migration:CHANGE_ME_migration_password@db:5432/nurseapp

# Backup agent connection
BACKUP_DATABASE_URL=postgresql://nurseapp_backup:CHANGE_ME_backup_password@db:5432/nurseapp

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379

# ── Auth / Session ────────────────────────────────────────────────────────────
# JWT access token (15 min memory, never in cookie)
JWT_SECRET=CHANGE_ME_jwt_secret_min_32_chars

# CSRF double-submit token
CSRF_SECRET=CHANGE_ME_csrf_secret_min_32_chars

# nurseapp_refresh cookie: HttpOnly Secure SameSite=Lax, scoped to /api/v1/auth
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=Lax

# ── PDPL / Encryption (§8.3) ──────────────────────────────────────────────────
# AES-256-GCM field-level encryption (Iqama, Passport, SCFHS reg number)
# Rotate via key_version — old keys must be retained in vault during migration
PDPL_FIELD_ENCRYPTION_KEY=CHANGE_ME_hex_64_chars_aes256_key
PDPL_BLIND_INDEX_KEY=CHANGE_ME_hex_64_chars_hmac_pepper
PDPL_KEY_VERSION=1

# ── SCFHS Integration (§5.4) ──────────────────────────────────────────────────
SCFHS_BASE_URL=https://api.scfhs.org.sa/v1
SCFHS_MTLS_CERT=/run/secrets/scfhs_cert.pem   # mTLS client certificate
SCFHS_MTLS_KEY=/run/secrets/scfhs_key.pem     # mTLS client private key

# ── Object Storage / Evidence Vault (§5.3) ───────────────────────────────────
# KSA residency required — me-central-1 ONLY (me-south-1 Bahrain NOT allowed)
STORAGE_PROVIDER=s3                           # s3 | azure | local (dev only)
STORAGE_BUCKET=aigh-nursing-evidence
STORAGE_REGION=me-central-1
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_SIGNED_URL_TTL=30                     # seconds — then 403

# ── SMTP (§7.2) ───────────────────────────────────────────────────────────────
SMTP_HOST=mail.aigh.sa
SMTP_PORT=587
SMTP_USER=nurseapp@aigh.sa
SMTP_PASS=CHANGE_ME_smtp_password
SMTP_FROM=nurseapp@aigh.sa

# ── Push Notifications (§7.6) ─────────────────────────────────────────────────
FCM_SERVER_KEY=CHANGE_ME_fcm_key
HOSPITAL_PUSH_GATEWAY_URL=https://push.aigh.sa/v1/send
HOSPITAL_PUSH_GATEWAY_KEY=CHANGE_ME

# ── Backup / PITR (§10.6) ────────────────────────────────────────────────────
# GPG public key fingerprint for backup encryption
# Private key lives ONLY on the restore host — never in this env
BACKUP_GPG_KEY_ID=CHANGE_ME_gpg_key_fingerprint
BACKUP_RETENTION_DAYS=30
WAL_RETENTION_DAYS=7
BACKUP_STALE_THRESHOLD_HOURS=26              # alert if last backup > 26h

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_ID=worker-1
DAILY_SCAN_CRON=0 3 * * *                    # 06:00 Asia/Riyadh = 03:00 UTC
SCFHS_SYNC_CRON=0 1 * * *                    # nightly

# ── PAM / Break-Glass (§3.5–3.6) ─────────────────────────────────────────────
PAM_ELEVATION_TTL_MINUTES=60
BREAK_GLASS_TTL_HOURS=4
BREAK_GLASS_ALERT_EMAILS=ceo@aigh.sa,it-director@aigh.sa

# ── Observability ─────────────────────────────────────────────────────────────
CONSISTENCY_AUDIT_SAMPLE_RATE=0.01           # 1% daily workforce sample
ELIGIBILITY_DRIFT_ALERT_THRESHOLD=0.05       # alert if drift > 5%

# ── API Versioning ────────────────────────────────────────────────────────────
API_V1_BASE=/api/v1
API_V2_BASE=/api/v2
API_V1_SUNSET_DATE=2027-06-01                # 90-day sunset after v2 stable
