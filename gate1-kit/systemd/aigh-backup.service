[Unit]
Description=AIGH Nursing Workforce PostgreSQL Nightly Backup & WAL Prune
Documentation=https://github.com/cpercibal2018-cmyk/nurse_appV03/tree/main/gate1-kit
After=postgresql.service network.target

[Service]
Type=oneshot
User=postgres
Group=postgres
EnvironmentFile=-/etc/default/aigh-backup
ExecStart=/bin/bash /opt/nurse_appV03/gate1-kit/scripts/nightly-backup.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
