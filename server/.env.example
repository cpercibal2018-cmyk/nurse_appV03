# Local development (server run directly with npm). Docker sets its own via compose.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nurseapp
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Secret used to sign/verify API access tokens (HS256 JWT). Use a long random
# value (>=32 chars) in any shared or deployed environment. If unset, the server
# falls back to an insecure dev secret and logs a warning — never rely on that
# outside local development.
JWT_SECRET=CHANGE_ME_min_32_char_random_secret
